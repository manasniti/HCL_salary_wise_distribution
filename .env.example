# ---------------------------------------------------------------------------
# Salary Intelligence — environment configuration
# Copy to .env and fill in. Never commit .env to version control.
# ---------------------------------------------------------------------------

# Option A: a single connection URL
# DATABASE_URL=postgresql+psycopg2://salary_app:CHANGE_ME@localhost:5432/salary_intelligence?sslmode=prefer

# Option B: individual settings (used when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=salary_intelligence
POSTGRES_USER=salary_app
POSTGRES_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full  (use require+ in production)
POSTGRES_SSLMODE=prefer

# Branding
APP_NAME=Salary Intelligence
APP_TAGLINE=Department Wise Salary Distribution
ORGANISATION_NAME=Enterprise Banking Analytics
CURRENCY_SYMBOL=₹

# Security
SESSION_IDLE_TIMEOUT_MINUTES=20
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# Uploads (keep MAX_UPLOAD_MB in sync with .streamlit/config.toml maxUploadSize)
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=100000
